{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git clean -f*)",
      "Bash(git clean --force*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -B *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout --force*)",
      "Bash(git switch -f*)",
      "Bash(git switch -C *)",
      "Bash(git switch --force*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git restore .)",
      "Bash(git rebase -i*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase --continue*)",
      "Bash(git rebase --skip*)",
      "Bash(git rebase --quit*)",
      "Bash(git rebase --onto*)",
      "Bash(git rebase --exec*)",
      "Bash(git rebase --root*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --mirror*)",
      "Bash(git commit --amend*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git branch -D *)",
      "Bash(git branch -M *)",
      "Bash(git branch -f *)",
      "Bash(git branch --force*)",
      "Bash(git stash clear*)",
      "Bash(git stash drop*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git gc --prune*)",
      "Bash(git update-ref -d*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove --force*)",
      "Bash(git reset --keep*)",
      "Bash(git reset --soft *)",
      "Bash(git push -d *)",
      "Bash(git push --delete*)",
      "Bash(git push --prune*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git update-ref --delete*)",
      "Bash(git pull --rebase)",
      "Bash(git pull --rebase *)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(gh pr merge*)",
      "Bash(python3 tools/test_media_manifest.py --pin-visible*)",
      "Edit(/.claude/hooks/**)",
      "Write(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)",
      "Edit(/tools/approved-visible-text.json)",
      "Write(/tools/approved-visible-text.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-repo-safety.sh"
          }
        ]
      }
    ]
  }
}
